# Copy this file to ".env.local" and fill in your value, then restart `npm run dev`.
#
# The Google Apps Script web-app URL that receives registrations.
# See backend/SETUP.md for how to deploy it and get this URL.
VITE_APPS_SCRIPT_URL=

# Google Analytics 4 web-stream Measurement ID (Admin > Data streams).
# Analytics is only initialized in production builds when this value is set.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
